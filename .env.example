# انسخ هذا الملف باسم .env ثم عدّل القيم (للتشغيل المحلي فقط؛ على Render تُضبط من render.yaml)
PORT=3000
DATA_DIR=data
ORG_NAME=جمعية اقرأ لعلوم القرآن
# المنطقة الزمنية لمقارنة مواعيد فتح التسجيل وإغلاقه
TIME_ZONE=Asia/Riyadh
# مدة الجلسة بالساعات
SESSION_HOURS=12
# ضع 1 عند العمل عبر HTTPS، و1 إذا كان النظام خلف خادم وسيط
COOKIE_SECURE=0
TRUST_PROXY=0
# السماح بإنشاء حسابات المتسابقين من الصفحة العامة (0 لإيقافه)
ALLOW_SIGNUP=1
# حساب الإدارة العليا يُنشأ عند أول تشغيل إذا ضُبطت كلمة المرور (مؤقتة وتُغيّر عند أول دخول)
ADMIN_USERNAME=admin
ADMIN_NAME=الإدارة العليا
ADMIN_PASSWORD=
# نسخة احتياطية يومية من داخل التطبيق
AUTO_BACKUP=0

# ---- قنوات الإشعار الخارجية (اختيارية؛ متوقفة حتى تُضبط) ----
# البريد
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=مسابقة اقرأ <noreply@example.org>
# رسائل الجوال وواتساب عبر مزود يستقبل POST بصيغة JSON: { "to": "+973...", "message": "..." } مع Authorization: Bearer <token>
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
# رمز الدولة للأرقام المحلية، وساعات التذكير قبل الموعد
DEFAULT_COUNTRY_CODE=973
REMINDER_HOURS=24
